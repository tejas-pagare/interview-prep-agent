GROQ_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=groq:openai/gpt-oss-20b
JWT_SECRET=change-me-to-a-long-random-string-32+chars
# Neon: use the connection string from the Neon dashboard, but change the scheme to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Default (local dev): sqlite:///app.db
# Browser origins allowed to call the API. localhost/127.0.0.1 on any port already work.
# Add a LAN address or deployed frontend here, e.g. ["http://192.168.1.20:3000"]
# CORS_ORIGINS=["http://localhost:3000"]
